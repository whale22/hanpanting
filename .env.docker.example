# Windows Docker Desktop에서 공유가 허용된 절대 경로를 사용합니다.
MONGODB_DATA_PATH=C:/docker-data/hanpanting/mongodb

# Codex 호스트 중계기가 요청과 응답을 교환하는 경로입니다.
CODEX_BRIDGE_PATH=./.docker/codex-bridge

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
SEED_PASSWORD=Seed1234!
